# ── Server Configuration ─────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CW1 Backend API ─────────────────────────────────────────
# The base URL for the Phantasmagoria General Platform API
CW1_API_URL=http://localhost:3000/api

# ── Session Security ─────────────────────────────────────────
# Secret key used to sign session cookies for dashboard authentication
# Generate your own with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_dashboard_session_secret_here
