# ── Server Configuration ─────────────────────────────────────
# PORT: The port the Analytical Dashboard backend will listen on (default: 4000)
PORT=4000
# NODE_ENV: Set to 'production' to enable secure cookies and disable debug logs
NODE_ENV=development

# ── CW1 Backend API Integration ──────────────────────────────
# CW1_API_URL: The base URL for the Phantasmagoria General Platform API
# Used by the server-side proxy to securely route requests to the backend database.
CW1_API_URL=http://localhost:3000/api

# CW1_API_KEY: The secret Bearer Token used to authenticate proxy requests.
# You must generate this key from the CW1 Admin Dashboard and paste it here.
# Ensure it has the correct permissions (read:alumni, read:analytics, etc.)
CW1_API_KEY=YOUR_API_KEY_HERE

# ── Session Security ─────────────────────────────────────────
# SESSION_SECRET: Secret key used to sign session cookies for dashboard authentication
# Generate your own with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_dashboard_session_secret_here
