# ── Server Configuration ───────────────────────────────────────
# PORT: The port the General Platform backend will listen on (default: 3000)
PORT=3000
# NODE_ENV: Set to 'production' to enable secure cookies and disable debug logs
NODE_ENV=development

# ── Database Configuration (MySQL) ─────────────────────────────
# Credentials for the primary relational database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password_here
DB_NAME=phantasmagoria

# ── Security & Authentication ──────────────────────────────────
# JWT_SECRET: Used to sign and verify JSON Web Tokens for user authentication.
# Must be kept highly secret. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# SESSION_SECRET: Used to encrypt the express-session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_session_secret_here

# ── CORS & Routing ─────────────────────────────────────────────
# FRONTEND_URL: Used for generating absolute links (e.g. password resets)
FRONTEND_URL=http://localhost:3000

# ALLOWED_ORIGINS: Comma-separated list of origins permitted to make cross-origin requests
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Email Service (Nodemailer) ─────────────────────────────────
# Used for sending Verification and Password Reset emails.
EMAIL_USER=example@gmail.com
EMAIL_PASS=xkjl gdae ntsd msdv
